# Dockerfile

# 1. Choose a lightweight base image for Python to keep the final size small
FROM python:3.14-slim

# 2. Configure Python environment variables
# Prevent Python from writing .pyc files to disk
ENV PYTHONDONTWRITEBYTECODE=1
# Ensure console output is not buffered by Docker (crucial for real-time logging)
ENV PYTHONUNBUFFERED=1

# 3. Set the working directory inside the container
WORKDIR /app

# 4. Copy ONLY the requirements file first
# This is a best practice to leverage Docker's layer caching mechanism.
# If requirements.txt doesn't change, Docker skips the installation step on rebuilds.
COPY platgdia/dtblocks/vertiport_operator/requirements.txt /app/requirements.txt

# 5. Install the required Python packages (like paho-mqtt)
RUN pip install --no-cache-dir --root-user-action=ignore -r requirements.txt

# 6. Copy the rest of the application source code into the container
# Assuming your code is inside a 'src' folder
COPY . /app/uspace/
COPY platgdia/dtblocks/vertiport_operator/vertiport_operator_dtb.py /app/vertiport_operator_dtb.py

# 7. Define the default command to execute when the container launches
CMD ["python", "vertiport_operator_dtb.py"]